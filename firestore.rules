rules_version = '2';

// Firestore security rules for the Lectures app (project: mustttdb).
//
// Public university timetables remain read-only; telemetry and feedback keep
// their existing bounded write-only contracts. Personal collections require
// the authenticated account owner and validated payloads.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isOptString(val, maxLen) {
      return val == null || (val is string && val.size() <= maxLen);
    }

    function isOptInt(val) {
      return val == null || val is int;
    }


    // ---------------------------------------------------------------------
    // /timetable — published university teaching timetable.
    //
    // Public information (scraped from timetable.must.ac.ug), no personal data.
    // Readable without auth so the sync path can actually function; the client
    // cannot authenticate, so requiring auth here makes sync permanently dead.
    // Writes stay closed: the data is managed out of band.
    // ---------------------------------------------------------------------
    match /timetable/{entryId} {
      allow read: if true;
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // /user_telemetry — pseudonymous install heartbeat.
    //
    // READ IS DENIED. The client never reads this collection; the only access
    // is the write below. Leaving read open exposed install IDs, device models,
    // Android versions, enrolled programmes and launch counts to anyone holding
    // the (public, in-APK) API key.
    //
    // Writes cannot be tied to an identity because there is no auth, so the
    // shape is constrained instead: the document ID must match install_id and
    // the field set, types and lengths are validated.
    // ---------------------------------------------------------------------
    match /user_telemetry/{installId} {
      allow read: if false;
      allow delete: if false;

      allow create, update: if isValidTelemetry(installId);
    }

    function isValidTelemetry(installId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'install_id',
          'app_version',
          'enrolled_programme',
          'device_model',
          'android_version',
          'sdk_int',
          'first_launch_timestamp',
          'last_active_at',
          'total_launches',
          'features_used'
        ])
        // Bind the document to its own identifier so one install cannot
        // overwrite another install's record.
        && d.install_id is string
        && d.install_id == installId
        && d.install_id.size() <= 64
        && d.app_version is string && d.app_version.size() <= 32
        && d.enrolled_programme is string && d.enrolled_programme.size() <= 128
        && d.device_model is string && d.device_model.size() <= 128
        && d.android_version is string && d.android_version.size() <= 32
        && d.sdk_int is int && d.sdk_int >= 1 && d.sdk_int <= 100
        && d.first_launch_timestamp is int
        && d.last_active_at == request.time
        && d.total_launches is int && d.total_launches >= 0
        && d.features_used is map;
    }

    // ---------------------------------------------------------------------
    // /feedback — anonymous student feedback.
    //
    // Create-only. The client never reads this collection, so read, update and
    // delete are all denied. Field lengths are capped to keep a public,
    // unauthenticated write endpoint from being used as bulk storage.
    // ---------------------------------------------------------------------
    match /feedback/{feedbackId} {
      allow read, update, delete: if false;
      allow create: if isValidFeedback();
    }

    function isValidFeedback() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'id',
          'instanceId',
          'category',
          'categoryKey',
          'message',
          'formattedDate',
          'appVersion',
          'androidRelease',
          'deviceModel',
          'enrolledProgramme',
          'submittedAt'
        ])
        && d.id is string && d.id.size() <= 64
        && d.instanceId is string && d.instanceId.size() <= 64
        && d.category is string && d.category.size() <= 64
        && d.categoryKey is string && d.categoryKey.size() <= 64
        && d.message is string && d.message.size() <= 4000
        && d.formattedDate is string && d.formattedDate.size() <= 64
        && d.appVersion is string && d.appVersion.size() <= 32
        && d.androidRelease is string && d.androidRelease.size() <= 32
        && d.deviceModel is string && d.deviceModel.size() <= 128
        && d.enrolledProgramme is string && d.enrolledProgramme.size() <= 128
        && d.submittedAt is int;
    }

    // ---------------------------------------------------------------------
    // /users/{userId} — personal user data sync (Auth Gated).
    //
    // Requires an authenticated user matching the document ID.
    // Covers notes, events, assignments, settings, onboarding.
    // ---------------------------------------------------------------------
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /notes/{noteId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidNote(userId, noteId);
      }

      match /events/{eventId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidEvent(userId, eventId);
      }

      match /assignments/{assignmentId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidAssignment(userId, assignmentId);
      }

      match /settings/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && docId == 'preferences' && isValidSettings();
      }
    }

    function isValidNote(userId, noteId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'natural_key',
          'title',
          'content',
          'colour_tag',
          'alarm_minutes',
          'tag',
          'attached_class',
          'attachment_name',
          'attachment_path',
          'is_pinned',
          'is_deleted',
          'owner_id',
          'updated_at'
        ])
        && d.natural_key is string && d.natural_key == noteId && d.natural_key.size() > 0 && d.natural_key.size() <= 256
        && isOptString(d.get("title", null), 300)
        && d.content is string && d.content.size() <= 100000
        && isOptString(d.get("colour_tag", null), 32)
        && isOptInt(d.get("alarm_minutes", null))
        && isOptString(d.get("tag", null), 64)
        && isOptString(d.get("attached_class", null), 256)
        && isOptString(d.get("attachment_name", null), 256)
        && isOptString(d.get("attachment_path", null), 512)
        && d.is_pinned is bool
        && d.is_deleted is bool
        && d.owner_id is string && d.owner_id == userId
        && (d.updated_at is int || d.updated_at is timestamp);
    }

    function isValidEvent(userId, eventId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'client_uuid',
          'title',
          'day_of_week',
          'start_time',
          'end_time',
          'location',
          'notes',
          'repeat_weekly',
          'alarm_minutes',
          'category',
          'color_tag',
          'owner_id',
          'updated_at',
          'is_deleted'
        ])
        && d.client_uuid is string && d.client_uuid == eventId && d.client_uuid.size() > 0 && d.client_uuid.size() <= 128
        && d.title is string && d.title.size() > 0 && d.title.size() <= 300
        && d.day_of_week is string && d.day_of_week.size() <= 32
        && d.start_time is string && d.start_time.size() <= 32
        && d.end_time is string && d.end_time.size() <= 32
        && d.location is string && d.location.size() <= 200
        && d.notes is string && d.notes.size() <= 10000
        && d.repeat_weekly is bool
        && isOptInt(d.get("alarm_minutes", null))
        && d.category is string && d.category.size() <= 64
        && d.color_tag is string && d.color_tag.size() <= 32
        && d.owner_id is string && d.owner_id == userId
        && d.updated_at is int
        && d.is_deleted is bool;
    }

    function isValidAssignment(userId, assignmentId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'client_uuid',
          'title',
          'course_code',
          'due_date',
          'reminder_minutes',
          'priority',
          'notes',
          'completed',
          'owner_id',
          'updated_at',
          'is_deleted'
        ])
        && d.client_uuid is string && d.client_uuid == assignmentId && d.client_uuid.size() > 0 && d.client_uuid.size() <= 128
        && d.title is string && d.title.size() > 0 && d.title.size() <= 300
        && d.course_code is string && d.course_code.size() <= 64
        && d.due_date is string && d.due_date.size() <= 64
        && isOptInt(d.get("reminder_minutes", null))
        && d.priority is string && d.priority.size() <= 32
        && d.notes is string && d.notes.size() <= 10000
        && d.completed is bool
        && d.owner_id is string && d.owner_id == userId
        && d.updated_at is int
        && d.is_deleted is bool;
    }

    function isValidSettings() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'programme',
          'theme_mode',
          'theme_accent',
          'notifications_enabled',
          'class_alarm_lead_minutes',
          'task_reminder_lead_hours',
          'alarm_vibration',
          'alarm_sound',
          'academic_year',
          'semester',
          'updated_at'
        ])
        && isOptString(d.get("programme", null), 128)
        && d.theme_mode is string && d.theme_mode.size() <= 32
        && d.theme_accent is int
        && d.notifications_enabled is bool
        && d.class_alarm_lead_minutes is int
        && d.task_reminder_lead_hours is int
        && d.alarm_vibration is bool
        && d.alarm_sound is string && d.alarm_sound.size() <= 64
        && d.academic_year is string && d.academic_year.size() <= 32
        && d.semester is string && d.semester.size() <= 32
        && d.updated_at is int;
    }

    // Default deny for anything not matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
